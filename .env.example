# Application
PROJECT_NAME="Agbale"
ORGANIZATION_NAME="Bibliothèque Publique Agbale"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT="development"
BINDING_HOST="0.0.0.0"
BINDING_PORT=8000

# Security / JWT
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY="agbale-super-secret-development-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default async SQLite for rapid local development:
DATABASE_URL="sqlite+aiosqlite:///./agbale.db"
# PostgreSQL for production:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/agbale_db"

# Initial Superuser Seed (automatically created if not present on startup)
FIRST_SUPERUSER_NAME="System Administrator"
FIRST_SUPERUSER_EMAIL="admin@agbale.org"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"

# CORS Allowed Origins (comma separated)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"
